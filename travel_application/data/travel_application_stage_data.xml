<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default stages; administrators can rename, reorder and add more -->
    <record id="stage_new" model="travel.application.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
        <field name="lines_editable" eval="True"/>
    </record>
    <record id="stage_data_gathering" model="travel.application.stage">
        <field name="name">Data Gathering</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_in_progress" model="travel.application.stage">
        <field name="name">In Progress</field>
        <field name="sequence">30</field>
        <field name="lines_must_be_done" eval="True"/>
    </record>
    <record id="stage_done" model="travel.application.stage">
        <field name="name">Done</field>
        <field name="sequence">40</field>
    </record>
    <record id="stage_canceled" model="travel.application.stage">
        <field name="name">Canceled</field>
        <field name="sequence">50</field>
        <field name="fold" eval="True"/>
        <field name="is_cancel" eval="True"/>
    </record>
</odoo>
