<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access levels of the Applications app -->
    <record id="module_category_travel_application" model="ir.module.category">
        <field name="name">Applications</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_travel_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_travel_application"/>
        <!-- Agents sell: they create the sales orders of their own applications -->
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_travel_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_travel_application"/>
        <!-- Administrators see every application's sales orders -->
        <field name="implied_ids" eval="[(4, ref('group_travel_agent')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company: users only see applications of their allowed companies -->
    <record id="travel_application_company_rule" model="ir.rule">
        <field name="name">Applications: allowed companies</field>
        <field name="model_id" ref="model_travel_application"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Agents see only the applications they are responsible for, and their lines -->
    <record id="travel_application_rule_agent" model="ir.rule">
        <field name="name">Applications: agents see their own</field>
        <field name="model_id" ref="model_travel_application"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_travel_agent'))]"/>
    </record>
    <record id="travel_application_line_rule_agent" model="ir.rule">
        <field name="name">Application lines: agents see their own</field>
        <field name="model_id" ref="model_travel_application_line"/>
        <field name="domain_force">[('application_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_travel_agent'))]"/>
    </record>

    <!-- Administrators see every application; rules of different groups add up -->
    <record id="travel_application_rule_admin" model="ir.rule">
        <field name="name">Applications: administrators see all</field>
        <field name="model_id" ref="model_travel_application"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_travel_admin'))]"/>
    </record>
    <record id="travel_application_line_rule_admin" model="ir.rule">
        <field name="name">Application lines: administrators see all</field>
        <field name="model_id" ref="model_travel_application_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_travel_admin'))]"/>
    </record>
</odoo>
