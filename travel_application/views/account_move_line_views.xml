<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal items: the partner's running balance after each item -->
    <record id="account_move_line_view_list_travel" model="ir.ui.view">
        <field name="name">account.move.line.list.travel</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="credit" position="after">
                <field name="travel_balance" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
