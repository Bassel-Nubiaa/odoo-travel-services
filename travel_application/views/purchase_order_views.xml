<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase order: show the application it was created from -->
    <record id="purchase_order_view_form_travel" model="ir.ui.view">
        <field name="name">purchase.order.form.travel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="travel_application_id"
                       invisible="not travel_application_id"
                       groups="travel_application.group_travel_agent"/>
            </field>
        </field>
    </record>
</odoo>
