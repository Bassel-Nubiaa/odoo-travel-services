<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stages: editable list, ordered by the drag handle -->
    <record id="travel_application_stage_view_list" model="ir.ui.view">
        <field name="name">travel.application.stage.list</field>
        <field name="model">travel.application.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="lines_editable"/>
                <field name="lines_must_be_done"/>
                <field name="is_cancel"/>
            </list>
        </field>
    </record>

    <record id="travel_application_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">travel.application.stage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
