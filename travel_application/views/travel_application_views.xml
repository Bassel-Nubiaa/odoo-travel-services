<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban: the main view, one column per stage -->
    <record id="travel_application_view_kanban" model="ir.ui.view">
        <field name="name">travel.application.kanban</field>
        <field name="model">travel.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false" sample="1">
                <field name="stage_id"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="partner_id"/>
                        <field name="currency_id" class="text-muted"/>
                        <footer class="pt-1">
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List -->
    <record id="travel_application_view_list" model="ir.ui.view">
        <field name="name">travel.application.list</field>
        <field name="model">travel.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="stage_id"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="amount_sales" sum="Total" optional="hide" groups="travel_application.group_travel_admin"/>
                <field name="amount_purchases" sum="Total" optional="hide" groups="travel_application.group_travel_admin"/>
                <field name="amount_profit"
                       sum="Total"
                       optional="hide"
                       decoration-danger="amount_profit &lt; 0"
                       groups="travel_application.group_travel_admin"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="travel_application_view_form" model="ir.ui.view">
        <field name="name">travel.application.form</field>
        <field name="model">travel.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <header>
                    <button name="action_create_sale_order"
                            type="object"
                            string="Create Sales Order"
                            class="btn-primary"
                            invisible="sale_order_id or not can_create_orders"/>
                    <button name="action_create_purchase_orders"
                            type="object"
                            string="Create Purchase Orders"
                            class="btn-secondary"
                            invisible="not has_lines_to_purchase or not can_create_orders"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="lines_editable" invisible="1"/>
                    <field name="can_create_orders" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="has_lines_to_purchase" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar"
                                invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sales Order</span>
                            </div>
                        </button>
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-credit-card"
                                invisible="not purchase_order_count">
                            <field name="purchase_order_count" widget="statinfo" string="Purchases"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="not lines_editable"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="not lines_editable" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Details: one line per service; each line opens its own form -->
                        <page name="details" string="Details">
                            <!-- Lines are added, removed and reordered only in editable stages -->
                            <field name="line_ids"
                                   options="{'create': [('lines_editable', '=', True)], 'delete': [('lines_editable', '=', True)]}">
                                <list>
                                    <field name="sequence" widget="handle" readonly="not parent.lines_editable"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="cost_currency_id" column_invisible="1"/>
                                    <field name="passenger_name"/>
                                    <field name="product_id"/>
                                    <field name="vendor_id" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="cost" optional="show"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-info="state == 'gathering'"
                                           decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <!-- Overview: administrators only; amounts in the company currency -->
                        <page name="overview" string="Overview" groups="travel_application.group_travel_admin">
                            <field name="company_currency_id" invisible="1"/>
                            <group>
                                <group>
                                    <field name="vendor_count"/>
                                    <field name="amount_sales"/>
                                </group>
                                <group>
                                    <field name="amount_purchases"/>
                                    <field name="amount_profit"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Amounts are in the company currency, converted at the rate of the day
                                each price was last set.
                            </p>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="travel_application_view_search" model="ir.ui.view">
        <field name="name">travel.application.search</field>
        <field name="model">travel.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="my_applications" string="My Applications" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_agent" string="Responsible Agent" context="{'group_by': 'user_id'}"/>
                    <filter name="group_client" string="Paying Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="travel_application_action" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">travel.application</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="travel_application_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first application</p>
            <p>One application per paying client: visas, tickets, hotels and every other service they need.</p>
        </field>
    </record>
</odoo>
